# Copy this file to .env.local for local development.
# Never put real secret values in this file.

# -----------------------------------------------------------------------------
# App runtime
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_KEY=replace-with-a-long-random-internal-api-key

# Optional feature flags. Use comma-separated name=true/false tokens.
FEATURE_FLAGS=emailDeliveryApi=true,strictApiRateLimiting=true,telemetryIngestion=true
NEXT_PUBLIC_FEATURE_FLAGS=integrityDeterrentMode=false

# -----------------------------------------------------------------------------
# Auth.js — the only authentication provider
# -----------------------------------------------------------------------------

# Signs the short-lived JWT that Convex verifies. Generate a keypair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
# The public half is served at /.well-known/jwks.json; never publish the private.
AUTH_JWT_KID=k1
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----\n"

# Auth.js cookie/session secret. Generate with `openssl rand -base64 32`.
AUTH_SECRET=replace-with-a-long-random-secret

# OAuth providers.
AUTH_GOOGLE_ID=replace-me
AUTH_GOOGLE_SECRET=replace-me
AUTH_GITHUB_ID=replace-me
AUTH_GITHUB_SECRET=replace-me

# Shared secret guarding convex/authAdapter.ts, which Auth.js calls to create
# users and link OAuth identities. Those functions have a public endpoint, so
# this value is what stands in front of them.
#
# Must be set to the SAME value in two places, or every sign-in fails:
#   here (the Next server), and
#   `npx convex env set AUTH_ADAPTER_SECRET <value>` (the Convex deployment).
#
# Deliberately not a reuse of INTERNAL_API_KEY, which guards Convex calling into
# Next. One credential spanning both directions means a leak in either
# compromises both.
AUTH_ADAPTER_SECRET=replace-with-a-long-random-secret

# Origin Auth.js builds redirect and error URLs from.
#
# Usually leave this unset. The Docker image defaults it to the
# NEXT_PUBLIC_APP_URL it was built with, which is what makes OAuth work behind a
# reverse proxy that does not forward the Host header -- without it, Auth.js
# resolves the origin to the container's bind address and sends the browser to
# https://0.0.0.0:3000/...
#
# Set it only when a deployment's public URL differs from the one baked into the
# image, or when running outside Docker behind a proxy.
# AUTH_URL=https://commit.example.com

# Set this on the Convex deployment with `npx convex env set SITE_URL ...`.
# It must match the `iss` claim of the tokens we mint, so no trailing slash.
# Keep it here only as a setup checklist item.
SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Convex backend
# -----------------------------------------------------------------------------

CONVEX_DEPLOYMENT=dev:your-convex-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-convex-deployment.convex.site

# Required for non-interactive Convex deploys and the backup worker.
CONVEX_DEPLOY_KEY=replace-with-your-convex-deploy-key

# Set this on the Convex deployment with `npx convex env set OWNER_EMAILS ...`.
# Supports comma, semicolon, space, or newline-separated email addresses.
OWNER_EMAILS=owner@example.com

# -----------------------------------------------------------------------------
# Stream video
# -----------------------------------------------------------------------------

NEXT_PUBLIC_STREAM_API_KEY=replace-with-your-stream-api-key
STREAM_SECRET_KEY=replace-with-your-stream-secret-key

# -----------------------------------------------------------------------------
# SMTP email
# -----------------------------------------------------------------------------

# Optional in local development. REQUIRED in production — the transport now
# refuses to send and reports failure if these are missing in production, rather
# than logging and reporting success (which made a missing secret invisible).
#
# Provider: Resend free tier (3,000/month, 100/day). See docs/email-provider-setup.md.
#
# SMTP_USER is the literal string "resend" — not your email address. SMTP_PASS
# is a Resend API key (starts with re_).
#
# Port 587 with SMTP_SECURE=false is correct: that is STARTTLS, which upgrades
# the connection after connecting. Setting true on 587 makes the handshake fail;
# use true only with 465 or 2465.
#
# These same seven values must ALSO be set on the Convex deployment
# (`npx convex env set ...`) — Convex sends mail from its own runtime and cannot
# read this file. Setting only one side gives a system where half the mail
# silently fails.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_replace_with_your_resend_api_key
SMTP_FROM_NAME=Commit
# The app subdomain, not the root: root mail is Zoho human mail, and keeping
# them apart means an app sending incident cannot damage personal correspondence.
SMTP_FROM_EMAIL=notifications@commit.kunjdeveloper.com

# -----------------------------------------------------------------------------
# Docker image and rollout
# -----------------------------------------------------------------------------

# Used by docker-compose.yml. Keep `latest` for Watchtower-based production rollout.
IMAGE_TAG=latest

# Docker group GID on the host. Used as a Docker build arg in CI.
DOCKER_GID=999

# Watchtower polling interval in seconds.
WATCHTOWER_POLL_INTERVAL=300

# Image cleanup interval in seconds.
IMAGE_GC_INTERVAL_SECONDS=86400

# -----------------------------------------------------------------------------
# Backup worker
# -----------------------------------------------------------------------------

# The Compose stack sets BACKUP_DIR to /data/backups for the backup container.
BACKUP_CRON=0 0 * * *
BACKUP_TZ=UTC
BACKUP_RETENTION=14
BACKUP_RUN_ON_START=0

# -----------------------------------------------------------------------------
# Optional monitoring profile
# -----------------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-before-exposing-grafana
GRAFANA_ROOT_URL=http://localhost:3001
